# OmniSurge — Testnet Deployment Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# Your testnet deployer private key (REQUIRED — do not share)
PRIVATE_KEY=0x_your_private_key_here

# RPC URLs (public endpoints — safe to commit)
BASE_SEPOLIA_RPC=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
REACTIVE_RPC=https://lasna-rpc.rnk.dev
